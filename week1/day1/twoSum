class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        
        
    //    for(int i=0;i<nums.size();i++){
    //     for(int j=i+1;j<nums.size();j++){
    //         if(nums[i]+nums[j]==target)
    //         return{i,j};
    //     }
    //    }
    //    return {};
    vector<pair<int,int>> v;

    for(int i = 0; i < nums.size(); i++) {
    v.push_back({nums[i], i});
    }
    
    sort(v.begin(),v.end());
    int lft=0;
    int rgt=v.size()-1;
    while(lft<rgt){
        int sum=v[lft].first+v[rgt].first;
        if(sum==target)
        return{v[lft].second,v[rgt].second};
        else if(sum<target){
            lft++;
        }
        else{
            rgt--;
        }
    }
    return{};

    }
};
